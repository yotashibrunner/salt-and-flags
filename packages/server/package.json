{
  "name": "@salt/server",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db.ts migrate",
    "test": "node --test src/economy/economy.test.mjs src/economy/market.test.mjs src/economy/persistence.test.mjs src/economy/demand.test.mjs src/economy/sinks.test.mjs src/economy/fuzz.test.mjs src/economy/sim.test.mjs src/pillage/battle.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "persist:live": "tsx persist.live.mts",
    "sim": "node src/economy/sim.mjs"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.0",
    "@colyseus/ws-transport": "^0.15.0",
    "@salt/shared": "*",
    "colyseus": "^0.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "ioredis": "^5.4.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
